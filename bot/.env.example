# Copy this file to .env for local development
# On Railway, set these in the Variables tab

# Required: your bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: path for the SQLite database file (default: jee_bot.db)
# On Railway, mount a volume and point DB_PATH to it for persistence
DB_PATH=jee_bot.db
